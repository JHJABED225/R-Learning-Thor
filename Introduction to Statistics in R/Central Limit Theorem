

--====================================================================================================--
--Generating sample--

Function: sample(x, size, replace = FALSE, prob = NULL)
Here x is the output vector or source data. 
size= non-negative value. It defines how many elements to randomly select. 
replace = with or without replacement. 
prob= probability weight. By default it is null. 


# ====================================================================================================--
# Practice: Pick 3 unique colors randomly(without replacement) from color vector.
# ====================================================================================================--

  colors <- c("Red", "Green", "Blue", "Yellow", "Orange")
  sample(colors, size = 3)

# Output: [1] "Green" "Yellow" "Red"

